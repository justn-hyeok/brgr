#!/bin/sh
set -eu

case "${1:-}" in
  --version)
    printf 'gjc v-fixture\n'
    exit 0
    ;;
  --help)
    printf '%s\n' '-p, --print' '--mode=<value>' '--no-session' '--no-mcp' '--model' '--thinking'
    exit 0
    ;;
esac

prompt_file=''
for argument in "$@"; do
  case "$argument" in
    @*) prompt_file=${argument#@} ;;
  esac
done

if [ -n "$prompt_file" ] && /usr/bin/grep -q 'SLOW' "$prompt_file"; then
  /bin/sleep 30
fi
# A worker that leaves a file of its own, or only its harness cache.
if [ -n "$prompt_file" ] && /usr/bin/grep -q 'WRITE' "$prompt_file"; then
  printf 'worker output\n' > AGENT_OUTPUT.txt
fi
# A worker that edits an existing file, so a later rebase can change context.
if [ -n "$prompt_file" ] && /usr/bin/grep -q 'EDIT' "$prompt_file"; then
  printf 'seed\nedited\n' > README
fi
# A worker that adds the same line twice, for multiplicity checks.
if [ -n "$prompt_file" ] && /usr/bin/grep -q 'REPEAT' "$prompt_file"; then
  printf 'keep\nfoo\nfoo\n' > repeat.txt
fi
# A worker that leaves a binary file; git diffs this as a binary patch.
if [ -n "$prompt_file" ] && /usr/bin/grep -q 'BINARY' "$prompt_file"; then
  /usr/bin/printf '\000\001\002\377' > image.bin
fi
# A worker that starts its own repository inside the task and leaves it dirty.
if [ -n "$prompt_file" ] && /usr/bin/grep -q 'NESTED' "$prompt_file"; then
  /bin/mkdir -p vendor/lib
  (
    cd vendor/lib
    /usr/bin/git init -q
    printf 'v1\n' > lib.txt
    /usr/bin/git add lib.txt
    /usr/bin/git -c user.name=Worker -c user.email=worker@example.invalid commit -qm lib
    printf 'uncommitted work\n' > work.txt
  )
fi
if [ -n "$prompt_file" ] && /usr/bin/grep -q 'CACHE' "$prompt_file"; then
  /bin/mkdir -p .gjc
  printf '{}\n' > .gjc/session.json
fi
printf '%s\n' '{"type":"message_end","message":{"role":"assistant","content":[{"type":"text","text":"BRGR_FIXTURE_OK"}]}}'
printf '%s\n' '{"type":"agent_end","stopReason":"completed"}'
