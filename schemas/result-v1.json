{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brgr.dev/schemas/result-v1.json",
  "title": "brgr ResultEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "revision", "attempt_id", "result_id", "outcome", "artifacts", "error", "unresolved_effects"],
  "properties": {
    "schema": { "const": "brgr/v1" },
    "task_id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "attempt_id": { "type": "string", "format": "uuid" },
    "result_id": { "type": "string", "format": "uuid" },
    "outcome": { "enum": ["candidate", "failed", "cancelled", "lost"] },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["digest", "bytes", "media_type", "store_relative_path"],
        "properties": {
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "media_type": { "type": "string" },
          "store_relative_path": { "type": "string" }
        }
      }
    },
    "error": { "type": ["string", "null"] },
    "route_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "model_source", "effort", "effort_source"],
      "properties": {
        "model": { "type": ["string", "null"] },
        "model_source": { "enum": ["harness_jsonl", "unavailable"] },
        "effort": { "type": ["string", "null"] },
        "effort_source": { "enum": ["harness_jsonl", "unavailable"] }
      }
    },
    "unresolved_effects": { "type": "array", "items": { "type": "string" } }
  }
}
